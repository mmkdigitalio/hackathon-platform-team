#!/bin/sh
set -eu
host=
# Auch bei store/erase die Eingabe bis zum Protokollende konsumieren.
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in host=*) host=${line#host=} ;; esac
done
if [ "${1:-}" = get ] && [ "$host" = github.com ] && [ -s /workspace/.ops/gh-token ]; then
  printf 'username=x-access-token\npassword=%s\n' "$(cat /workspace/.ops/gh-token)"
fi
