{
  "name": "@mmk/platform",
  "private": true,
  "description": "Shared platform: Pulumi foundation, app runtime, catalog, schemas and bootstrap scripts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "conventions": "node dist/schemas/conventions/check.js"
  },
  "dependencies": {
    "@pulumi/azure-native": "3.29.0",
    "@pulumi/kubernetes": "4.34.2",
    "@pulumi/pulumi": "3.273.0",
    "@pulumi/random": "4.21.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "typescript": "6.0.3"
  }
}
