# Bootstrap configuration for one platform environment. Contains no secrets.
# Copy to platform/scripts/bootstrap/<env>.env (e.g. staging.env), fill in and commit
# it, so a repeated bootstrap uses the same values (operations/foundation/bootstrap.md).
# State resource group and container come from schemas/conventions/conventions.json.

# Azure subscription of the platform; the person running the bootstrap has Contributor on it.
SUBSCRIPTION_ID=
# Region for the state backend; normally the same as the stack config "location".
LOCATION=germanywestcentral
ENVIRONMENT=staging

# Repository that receives the repository secrets (needs admin rights).
GITHUB_REPO=mmkdigitalio/hackathon-platform-team
# GitHub App of the agent (no secret; the private key is passed as GITHUB_APP_PRIVATE_KEY_FILE)
# and the repositories it must be installed on with write access.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
AGENT_REPOS="mmkdigitalio/hackathon-platform-team mmkdigitalio/hackathon-platform-affine"

# Pulumi state backend, shared by all stacks and environments.
# Globally unique, 3-24 lowercase letters and digits, e.g. stmmkstate<random>.
STATE_STORAGE_ACCOUNT=

# Optional, only used by the preflight check: regional availability of the size and the
# vCPU quota (VM family and region) for NODE_COUNT nodes (default 1). Keep both equal to
# the stack config nodeVmSize and nodeCount.
NODE_VM_SIZE=
NODE_COUNT=
